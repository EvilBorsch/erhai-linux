# AppArmor mediation for strictly confined snapd applications.
# defconfig already supplies audit, seccomp, namespaces and cgroup BPF.
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,apparmor,ipe,bpf"
# Snaps are squashfs images that applications read from at random through
# page faults, from several threads at once. Decompress on every CPU in
# parallel and straight into the page cache, as distributions built around
# snaps do; the defaults (one decompressor for the whole system, through an
# intermediate cache) serialise every read of every snap.
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
