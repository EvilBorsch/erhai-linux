# SPDX-License-Identifier: GPL-2.0-only
# OnePlus Pad 3 (erhai) board options. Merge on top of arm64 defconfig,
# erhai-firstboot.config, sm8750-peripherals.config and
# sm8750-netfilter.config.
#
# PPS fast charging through the SC8547A charge pumps. The pen charger
# stays off.
CONFIG_CHARGER_SC8547A=m
CONFIG_CHARGER_ERHAI_PPS=m
CONFIG_CHARGER_CPS8601=m
# Large console font for the 3392x2400 panel.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# Pogo keyboard and touchpad, also usable from the initramfs shell.
CONFIG_KEYBOARD_ONEPLUS_POGO=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# The root filesystem lives on UFS; the initramfs mounts it directly.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# No raw UFS commands from userspace.
# CONFIG_SCSI_UFS_BSG is not set
# Encrypted root: the UFS inline crypto engine encrypts userdata through
# dm-inlinecrypt, with dm-crypt on the CPU AES instructions as the fallback.
# cryptsetup needs the user space cipher and hash interfaces for the LUKS
# key slots.
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INLINECRYPT=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
# CONFIG_SCSI_UFS_CDNS_PLATFORM is not set
# Release name of the installed kernel and its modules.
CONFIG_LOCALVERSION="-erhai"
# Buffers for libcamera software ISP output.
CONFIG_UDMABUF=y
# Run programs of other architectures through a registered interpreter.
CONFIG_BINFMT_MISC=y
# Camera clocks, CSI PHYs and the camera I2C controller probe during startup,
# before the storage password, so they never wait on modules loaded later.
CONFIG_SM_CAMCC_8750=y
CONFIG_PHY_QCOM_MIPI_CSI2=y
CONFIG_I2C_QCOM_CCI=y
# Responsiveness for the Denial shell, as in Denial's own erhai kernel
# (linux-perpetua erhai-boot-72): per-task utilization clamping, which
# deniald uses to keep a CPU floor while frames are produced
# (DENIAL_UI_CPU_MIN), and a 1000 Hz tick.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_HZ_1000=y
# CONFIG_HZ_250 is not set

# Droidloom: Android apps in Wayland windows (denialwm/droidloom), checked against
# Denial's erhai kernel on which it runs; research/droidloom/README.md in the workspace.
# Binder through binderfs. Linux 7.4 has only the Rust Binder driver, and its
# binderfs (filesystem "binder") is built in with it; there is no separate
# ANDROID_BINDERFS. Droidloom mounts a private binderfs and creates binder,
# hwbinder and vndbinder through binder-control. Binder cannot be a module.
# CONFIG_RUST is silently dropped when the Rust toolchain is missing
# (make rustavailable): check the resulting .config.
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y

# Android's system, system_ext and product images are EROFS with LZ4
# compression (dump.erofs: lz4_0padding), with file capabilities and
# SELinux labels in security.* extended attributes.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y

# Android's netd sets up its networks with IPv4 and IPv6 policy routing; its
# RouteController exits netd when either is missing (Droidloom's netd patch
# tolerates missing iptables and XFRM, not this).
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# ART's concurrent mark-compact garbage collector uses userfaultfd. Denial's
# kernel has it; GKI kernels for Android 15+ must.
CONFIG_USERFAULTFD=y

# In Denial's kernel; no Droidloom code path that needs it was found
# (kcmp, PR_SET_MM, /proc/PID/map_files). Recommended to match the kernel
# Droidloom was validated on.
CONFIG_CHECKPOINT_RESTORE=y
